msgstr "Το αρχείο Digests είναι ενημερωμένο."

msgid "The following files will have their checksum faked:"
msgstr "Το άθροισμα ελέγχου των ακόλουθων αρχείων θα παραποιηθεί:"

msgid "The following files digests will have their checksum cleaned:"
msgstr "Τα ακόλουθα αρχεία θα έχουν καθαρίσει το άθροισμα ελέγχου τους:"

msgid "Still ok to continue"
msgstr "Ακόμα εντάξει για να συνεχίσετε"

msgid "Remove the backup digest file, I want to play again"
msgstr "Αφαιρέστε το εφεδρικό αρχείο digest, θέλω να παίξω ξανά"

msgid "I have read and understood the disclaimer and wish to continue anyway."
msgstr "Έχω διαβάσει και κατανοήσει την αποποίηση ευθύνης και επιθυμώ να συνεχίσω ούτως ή άλλως."

msgid "Installed Dotclear version is %s"
msgstr "Η εγκατεστημένη έκδοση του Dotclear είναι %s"

msgid "The installed PHP version is %1$s, the next version of Dotclear requires %2$s or higher."
msgstr "Η εγκατεστημένη έκδοση του PHP είναι %1$s, ενώ η επόμενη έκδοση του Dotclear απαιτεί %2$s ή νεότερη έκδοση."

msgid "Backup directory \"%s\" does not exist or is not writable."
msgstr "Ο εφεδρικός κατάλογος \"%s\" δεν υπάρχει ή δεν είναι εγγράψιμος."

msgid "Your are using Sqlite database driver, Database structure upgrade will NOT be performed."
msgstr "Χρησιμοποιείτε το πρόγραμμα οδήγησης βάσης δεδομένων Sqlite, ΔΕΝ θα πραγματοποιηθεί αναβάθμιση της δομής της βάσης δεδομένων."

msgid "Your are using developement release, some features are not available."
msgstr "Χρησιμοποιείτε την έκδοση ανάπτυξης, ορισμένα χαρακτηριστικά δεν είναι διαθέσιμα."

msgid "Dotclear digests file \"%s\" is not readable."
msgstr "Το αρχείο Dotclear digests \"%s\" δεν είναι αναγνώσιμο."

msgid "Official plugins repository could not be updated as there is no URL set in configuration."
msgstr "Το επίσημο αποθετήριο πρόσθετων δεν ήταν δυνατό να ενημερωθεί, καθώς δεν υπάρχει διεύθυνση URL στη ρύθμιση παραμέτρων."

msgid "Do you read the official post about this release on Dotclear's blog?"
msgstr "Έχετε διαβάσει την επίσημη ανάρτηση σχετικά με αυτή την κυκλοφορία στο blog της Dotclear;"

msgid "Does your system support this release requirements like PHP version?"
msgstr "Υποστηρίζει το σύστημά σας τις απαιτήσεις αυτής της έκδοσης, όπως η έκδοση PHP;"

msgid "Does your plugins and themes are up to date?"
msgstr "Τα plugins και τα θέματά σας είναι ενημερωμένα;"

msgid "Note if some plugins crash your installation, go back here to disable or to remove or to update them."
msgstr "Σημειώστε ότι αν κάποια πρόσθετα καταστρέψουν την εγκατάστασή σας, επιστρέψτε εδώ για να τα απενεργοποιήσετε ή να τα αφαιρέσετε ή να τα ενημερώσετε."

msgid "Once update done, do not forget to check and update blogs themes."
msgstr "Μόλις γίνει η ενημέρωση, μην ξεχάσετε να ελέγξετε και να ενημερώσετε τα θέματα των ιστολογίων."

msgid "Before performing update you should take into account some informations listed bellow:"
msgstr "Πριν εκτελέσετε την ενημέρωση θα πρέπει να λάβετε υπόψη σας ορισμένες πληροφορίες που παρατίθενται παρακάτω:"

msgid "Install or upgrade languages from available languages"
msgstr "Εγκατάσταση ή αναβάθμιση γλωσσών από τις διαθέσιμες γλώσσες"

msgid "Install or upgrade languages from an upload a zip file"
msgstr "Εγκατάσταση ή αναβάθμιση γλωσσών από ένα αρχείο zip"

msgid "Some plugins could not be loaded."
msgstr "Κάποια πρόσθετα δεν μπόρεσαν να φορτωθούν."

msgid "There is no module to check"
msgstr "Δεν υπάρχει ενότητα για έλεγχο"

msgid "Store version"
msgstr "Έκδοση καταστήματος"

msgid "Check stores versions"
msgstr "Ελέγξτε τις εκδόσεις των καταστημάτων"

msgid "Check lastest stores versions"
msgstr "Ελέγξτε τις τελευταίες εκδόσεις των καταστημάτων"

msgid "You can check repositories for modules written explicitly for Dotclear release greater than %s."
msgstr "Μπορείτε να ελέγξετε τα αποθετήρια για ενότητες που γράφτηκαν ρητά για έκδοση του Dotclear μεγαλύτερη από %s."

msgid "No version available"
msgstr "Δεν υπάρχει διαθέσιμη έκδοση"

msgid "No update available"
msgstr "Δεν υπάρχει διαθέσιμη ενημέρωση"

msgid "Newer version available"
msgstr "Διαθέσιμη νεότερη έκδοση"

msgid "Modules list"
msgstr "Κατάλογος ενοτήτων"

msgid "Latest version"
msgstr "Τελευταία έκδοση"

msgid "Written for Dotclear"
msgstr "Συντάχθηκε για την Dotclear"

msgid "Grow up from version %s successfully replayed."
msgstr "Μεγαλώστε από την έκδοση %s που επαναλαμβάνεται με επιτυχία."

msgid "Replay update actions"
msgstr "Ενέργειες ενημέρωσης επανάληψης"

msgid "Replay grow up action from version:"
msgstr "Επαναλάβετε τη δράση του μεγάλου από την έκδοση:"

msgid "Replay version lower than the last one can break your installation, do it at your own risk."
msgstr "Η αναπαραγωγή έκδοσης χαμηλότερης από την τελευταία μπορεί να καταστρέψει την εγκατάστασή σας, κάντε το με δική σας ευθύνη."

msgid "Dotclear %s is available."
msgstr "Dotclear %s είναι διαθέσιμο."

msgid "To upgrade your Dotclear installation simply click on the following button. A backup file of your current installation will be created in your root directory."
msgstr "Για να αναβαθμίσετε την εγκατάσταση Dotclear απλά κάντε κλικ στο παρακάτω κουμπί. Ένα αρχείο αντιγράφου ασφαλείας της τρέχουσας εγκατάστασής σας θα δημιουργηθεί στον ριζικό σας κατάλογο."

msgid "This update may potentially require some precautions, you should carefully read the information post associated with this release (see above)."
msgstr "Αυτή η ενημερωμένη έκδοση πιθανόν να απαιτεί ορισμένες προφυλάξεις, θα πρέπει να διαβάσετε προσεκτικά τις πληροφορίες που σχετίζονται με αυτήν την έκδοση (βλ. παραπάνω)."

