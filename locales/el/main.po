msgid "<strong>User</strong> indicates that the plugin has a specific configuration in the user preferences, generally used to add or modify certain behaviors or aspects of blog administration for the user."
msgstr "Ο <strong>χρήστης</strong> υποδεικνύει ότι το πρόσθετο έχει μια συγκεκριμένη διαμόρφωση στις προτιμήσεις του χρήστη, που χρησιμοποιείται γενικά για την προσθήκη ή την τροποποίηση ορισμένων συμπεριφορών ή πτυχών της διαχείρισης του ιστολογίου για τον χρήστη."

msgid "<strong>Settings</strong> indicates that the plugin has specific parameters on its management page."
msgstr "<strong>Οι ρυθμίσεις</strong> υποδεικνύουν ότι το πρόσθετο διαθέτει συγκεκριμένες παραμέτρους στη σελίδα διαχείρισης."

msgid "<strong>Other settings</strong> indicates that plugin has specific settings in other context."
msgstr "<strong>Άλλες ρυθμίσεις</strong> υποδεικνύει ότι το πρόσθετο έχει συγκεκριμένες ρυθμίσεις σε άλλο πλαίσιο."

msgid "<strong>Management</strong> indicates that the plugin has a specific management page."
msgstr "<strong>Διαχείριση</strong> υποδεικνύει ότι το πρόσθετο έχει μια συγκεκριμένη σελίδα διαχείρισης."

msgid "<strong>Widgets</strong> indicates that the plugin provide one or more widgets."
msgstr "<strong>Widgets</strong> υποδεικνύει ότι το πρόσθετο παρέχει ένα ή περισσότερα widgets."

