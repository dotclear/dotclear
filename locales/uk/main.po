msgstr "Видалити вибраний файл"

msgid "Please note that reverting your Dotclear version may have some unwanted side-effects. Consider reverting only if you experience strong issues with this new version."
msgstr "Зверніть увагу, що повернення до версії Dotclear може мати деякі небажані побічні ефекти. Розглядайте можливість повернення лише у випадку, якщо у вас виникли серйозні проблеми з новою версією."

msgid "You should not revert to version prior to last one (%s)."
msgstr "Ви не повинні повертатися до попередньої версії (%s)."

msgid "Delete all files but last"
msgstr "Видаліть усі файли, крім останнього"

msgid "Templates cache directory emptied."
msgstr "Каталог кешу шаблонів очищено."

msgid "Repositories cache directory emptied."
msgstr "Сховища кеш-директорії випорожнено."

msgid "Dotclear versions cache directory emptied."
msgstr "Випорожнено каталог кешу з нечіткими версіями."

msgid "Cache management"
msgstr "Керування кешем"

msgid "Cache folders"
msgstr "Теки кешу"

