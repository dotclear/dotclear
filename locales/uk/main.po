msgstr "Порожній каталог кешу репозиторіїв"

msgid "Empty Dotclear versions cache directory"
msgstr "Порожній каталог кешу версій Dotclear"

msgid "The updates have been performed."
msgstr "Оновлення були виконані."

msgid "No changed filed have been found, nothing to do!"
msgstr "Змінених файлів не знайдено, робити нічого!"

msgid "This tool has already been run once."
msgstr "Цей інструмент вже був запущений один раз."

