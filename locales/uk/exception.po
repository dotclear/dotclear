msgid "Site temporarily unavailable"
msgstr "Сайт тимчасово недоступний"

msgid "Bad Request"
msgstr "Поганий запит"

msgid "Blog handling error"
msgstr "Помилка обробки блогу"

msgid "Application configuration error"
msgstr "Помилка конфігурації програми"

msgid "Conflict"
msgstr "Конфлікт"

msgid "Application context error"
msgstr "Помилка контексту програми"

msgid "Database connection error"
msgstr "Помилка підключення до бази даних"

msgid "Not Found"
msgstr "Не знайдено"

msgid "Precondition Failed"
msgstr "Передумова не виконана"

msgid "Application process error"
msgstr "Помилка в процесі обробки заявки"

msgid "Session handling error"
msgstr "Помилка обробки сеансу"

msgid "Template handling error"
msgstr "Помилка обробки шаблону"

msgid "Unauthorized"
msgstr "Несанкціонований"

msgid "Internal Server Error"
msgstr "Внутрішня помилка сервера"

msgid "<p>This either means that the username and password information in your <strong>config.php</strong> file is incorrect or we can't contact the database server at \"<em>%1$s</em>\". This could mean your host's database server is down.</p><ul><li>Are you sure you have the correct username and password?</li><li>Are you sure that you have typed the correct hostname?</li><li>Are you sure that the database server is running?</li></ul><p>If you're unsure what these terms mean you should probably contact your host. If you still need help you can always visit the <a href=\"%2$s\">Dotclear Support Forums</a>.</p>"
msgstr "<p>Це означає, що інформація про ім'я користувача та пароль у вашому файлі <strong>config.php</strong> невірна, або ми не можемо зв'язатися з сервером бази даних за адресою \"<em>%1$s</em>\". Це може означати, що сервер бази даних вашого хостера не працює.</p><ul><li>Ви впевнені, що у вас правильні ім'я користувача та пароль?</li><li>Ви впевнені, що ввели правильне ім'я хоста?</li><li>Ви впевнені, що сервер бази даних працює?</li></ul><p>Якщо ви не впевнені, що ці терміни означають, вам слід звернутися до вашого хостера. Якщо вам все ще потрібна допомога, ви завжди можете відвідати <a href=\"%2$s\">форуми підтримки Dotclear</a>.</p>"

msgid "Dotclear release file is not readable"
msgstr "Файл релізу Dotclear не читається"

msgid "Dotclear is not installed or failed to load config file."
msgstr "Dotclear не встановлено або не вдалося завантажити конфігураційний файл."

msgid "%s cryptographic algorithm configured is not strong enough, please change it."
msgstr "%s налаштований криптографічний алгоритм недостатньо стійкий, будь ласка, змініть його."

msgid "%s directory does not exist. Please create it."
msgstr "%s не існує. Будь ласка, створіть його."

msgid "Dotclear release key %s was not found"
msgstr "Ключ до випуску Dotclear %s не знайдено."

msgid "Application can not be started twice."
msgstr "Додаток не може бути запущений двічі."

msgid "Unable to load deprecated core"
msgstr "Не вдається завантажити застаріле ядро"

msgid "<p>We apologize for this temporary unavailability.<br>Thank you for your understanding.</p>"
msgstr "<p>Просимо вибачення за тимчасову недоступність.<br>Дякуємо за розуміння.</p>"

msgid "Unable to find class %s"
msgstr "Не вдалося знайти клас %s"

msgid "Unable to initialize class %s"
msgstr "Не вдається ініціалізувати клас %s"

