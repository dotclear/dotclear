msgid "Site temporarily unavailable"
msgstr "Site temporar indisponibil"

msgid "Bad Request"
msgstr "Cerere proastă"

msgid "Blog handling error"
msgstr "Eroare de manipulare a blogului"

msgid "Application configuration error"
msgstr "Eroare de configurare a aplicației"

msgid "Conflict"
msgstr "Conflict"

msgid "Application context error"
msgstr "Eroare de context al aplicației"

msgid "Database connection error"
msgstr "Eroare de conexiune la baza de date"

msgid "Not Found"
msgstr "Nu a fost găsit"

msgid "Precondition Failed"
msgstr "Precondiție Eșuată"

