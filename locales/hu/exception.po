msgid "Site temporarily unavailable"
msgstr "Az oldal átmenetileg nem elérhető"

msgid "Bad Request"
msgstr "Rossz kérés"

msgid "Blog handling error"
msgstr "Blog kezelési hiba"

msgid "Application configuration error"
msgstr "Alkalmazás konfigurációs hiba"

msgid "Conflict"
msgstr "Konfliktus"

msgid "Application context error"
msgstr "Alkalmazási kontextus hiba"

msgid "Database connection error"
msgstr "Adatbáziskapcsolati hiba"

msgid "Not Found"
msgstr "Nem találták"

msgid "Precondition Failed"
msgstr "Előfeltétel sikertelen"

msgid "Application process error"
msgstr "Alkalmazási folyamat hibája"

msgid "Session handling error"
msgstr "Munkamenet kezelési hiba"

msgid "Template handling error"
msgstr "Sablon kezelési hiba"

msgid "Unauthorized"
msgstr "Jogosulatlan"

msgid "Internal Server Error"
msgstr "Belső szerver hiba"

msgid "<p>This either means that the username and password information in your <strong>config.php</strong> file is incorrect or we can't contact the database server at \"<em>%1$s</em>\". This could mean your host's database server is down.</p><ul><li>Are you sure you have the correct username and password?</li><li>Are you sure that you have typed the correct hostname?</li><li>Are you sure that the database server is running?</li></ul><p>If you're unsure what these terms mean you should probably contact your host. If you still need help you can always visit the <a href=\"%2$s\">Dotclear Support Forums</a>.</p>"
msgstr "<p>Ez vagy azt jelenti, hogy a <strong>config.php</strong> fájlban szereplő felhasználónév és jelszó helytelen, vagy nem tudunk kapcsolatba lépni az adatbázis-kiszolgálóval a \"<em>%1$s</em>\". Ez azt jelentheti, hogy a tárhelyszolgáltató adatbázis-kiszolgálója nem működik.</p><ul><li>Biztos, hogy a helyes felhasználónév és jelszó van megadva?</li><li>Biztos benne, hogy a helyes hostnevet írta be?</li><li>Biztos benne, hogy az adatbázis-kiszolgáló fut?</li></ul><p>Ha nem vagy biztos abban, hogy ezek a kifejezések mit jelentenek, akkor valószínűleg kapcsolatba kell lépned a tárhelyszolgáltatóval. Ha még mindig segítségre van szüksége, bármikor felkeresheti a <a href=\"%2$s\">Dotclear Support Fórumokat</a>.</p>"

msgid "Dotclear release file is not readable"
msgstr "A Dotclear kiadási fájl nem olvasható"

msgid "Dotclear is not installed or failed to load config file."
msgstr "A Dotclear nincs telepítve, vagy nem sikerült betölteni a konfigurációs fájlt."

msgid "%s cryptographic algorithm configured is not strong enough, please change it."
msgstr "%s a konfigurált kriptográfiai algoritmus nem elég erős, kérjük, változtassa meg."

msgid "%s directory does not exist. Please create it."
msgstr "%s könyvtár nem létezik. Kérjük, hozza létre."

msgid "Dotclear release key %s was not found"
msgstr "A Dotclear kiadási kulcs %s nem található"

msgid "Application can not be started twice."
msgstr "Az alkalmazás nem indítható el kétszer."

msgid "Unable to load deprecated core"
msgstr "Nem sikerült betölteni az elavult magot"

msgid "<p>We apologize for this temporary unavailability.<br>Thank you for your understanding.</p>"
msgstr "<p>Elnézést kérünk az ideiglenes elérhetetlenségért.<br>Köszönjük megértésüket.</p>"

msgid "Unable to find class %s"
msgstr "Nem találja a %sosztályt."

msgid "Unable to initialize class %s"
msgstr "Nem sikerült inicializálni a %sosztályt"

