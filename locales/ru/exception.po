msgid "Internal Server Error"
msgstr "Внутренняя ошибка сервера"

msgid "<p>This either means that the username and password information in your <strong>config.php</strong> file is incorrect or we can't contact the database server at \"<em>%1$s</em>\". This could mean your host's database server is down.</p><ul><li>Are you sure you have the correct username and password?</li><li>Are you sure that you have typed the correct hostname?</li><li>Are you sure that the database server is running?</li></ul><p>If you're unsure what these terms mean you should probably contact your host. If you still need help you can always visit the <a href=\"%2$s\">Dotclear Support Forums</a>.</p>"
msgstr "<p>Это означает, что имя пользователя и пароль в вашем файле <strong>config.php</strong> указаны неверно, либо мы не можем связаться с сервером базы данных по адресу \"<em>%1$s</em>\". Это может означать, что сервер базы данных вашего хостера не работает.</p><ul><li>Вы уверены, что у вас правильные имя пользователя и пароль?</li><li>Вы уверены, что ввели правильное имя хоста?</li><li>Уверены ли вы, что сервер базы данных запущен?</li></ul><p>Если вы не знаете, что означают эти термины, вам следует обратиться к своему хостеру. Если вам все еще нужна помощь, вы всегда можете посетить <a href=\"%2$s\">форумы поддержки Dotclear</a>.</p>"

msgid "Dotclear release file is not readable"
msgstr "Файл выпуска Dotclear не читается"

msgid "Dotclear is not installed or failed to load config file."
msgstr "Dotclear не установлен или не удалось загрузить файл конфигурации."

msgid "%s cryptographic algorithm configured is not strong enough, please change it."
msgstr "%s настроенный криптографический алгоритм недостаточно силен, пожалуйста, измените его."

msgid "%s directory does not exist. Please create it."
msgstr "%s каталог не существует. Пожалуйста, создайте его."

msgid "Dotclear release key %s was not found"
msgstr "Ключ выпуска Dotclear %s не найден"

msgid "Application can not be started twice."
msgstr "Приложение не может быть запущено дважды."

msgid "Unable to load deprecated core"
msgstr "Невозможно загрузить устаревшее ядро"

msgid "<p>We apologize for this temporary unavailability.<br>Thank you for your understanding.</p>"
msgstr "<p>Мы приносим извинения за временную недоступность.<br>Благодарим вас за понимание.</p>"

msgid "Unable to find class %s"
msgstr "Невозможно найти класс %s"

msgid "Unable to initialize class %s"
msgstr "Невозможно инициализировать класс %s"

