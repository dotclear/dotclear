msgid "Site temporarily unavailable"
msgstr "Trang web tạm thời không khả dụng."

msgid "Bad Request"
msgstr "Yêu cầu không hợp lệ"

msgid "Blog handling error"
msgstr "Lỗi xử lý blog"

msgid "Application configuration error"
msgstr "Lỗi cấu hình ứng dụng"

msgid "Conflict"
msgstr "Xung đột"

msgid "Application context error"
msgstr "Lỗi bối cảnh ứng dụng"

msgid "Database connection error"
msgstr "Lỗi kết nối cơ sở dữ liệu"

msgid "Not Found"
msgstr "Không tìm thấy"

msgid "Precondition Failed"
msgstr "Điều kiện tiên quyết không thành công"

msgid "Application process error"
msgstr "Lỗi trong quá trình nộp đơn"

msgid "Session handling error"
msgstr "Lỗi xử lý phiên làm việc"

msgid "Template handling error"
msgstr "Lỗi xử lý mẫu"

msgid "Unauthorized"
msgstr "Không được phép"

msgid "Internal Server Error"
msgstr "Lỗi máy chủ nội bộ"

msgid "<p>This either means that the username and password information in your <strong>config.php</strong> file is incorrect or we can't contact the database server at \"<em>%1$s</em>\". This could mean your host's database server is down.</p><ul><li>Are you sure you have the correct username and password?</li><li>Are you sure that you have typed the correct hostname?</li><li>Are you sure that the database server is running?</li></ul><p>If you're unsure what these terms mean you should probably contact your host. If you still need help you can always visit the <a href=\"%2$s\">Dotclear Support Forums</a>.</p>"
msgstr "<p>Điều này có nghĩa là thông tin tên người dùng và mật khẩu trong tệp <strong>config.php</strong> của bạn không chính xác hoặc chúng tôi không thể kết nối với máy chủ cơ sở dữ liệu tại \"<em>%1$s</em>\". Điều này có thể do máy chủ cơ sở dữ liệu của nhà cung cấp dịch vụ hosting của bạn đang bị ngừng hoạt động.</p><ul><li>Bạn có chắc chắn rằng mình đã nhập đúng tên người dùng và mật khẩu không?</li><li>Bạn có chắc chắn đã nhập đúng tên máy chủ không?</li><li>Bạn có chắc chắn rằng máy chủ cơ sở dữ liệu đang hoạt động không?</li></ul><p>Nếu bạn không chắc chắn về ý nghĩa của các thuật ngữ này, bạn nên liên hệ với nhà cung cấp dịch vụ hosting của mình. Nếu bạn vẫn cần hỗ trợ, bạn có thể truy cập <a href=\"%2$s\">diễn đàn hỗ trợ Dotclear</a>.</p>"

msgid "Dotclear release file is not readable"
msgstr "Tệp phát hành Dotclear không thể đọc được."

msgid "Dotclear is not installed or failed to load config file."
msgstr "Dotclear không được cài đặt hoặc không thể tải tệp cấu hình."

msgid "%s cryptographic algorithm configured is not strong enough, please change it."
msgstr "%s Thuật toán mã hóa được cấu hình không đủ mạnh, vui lòng thay đổi nó."

msgid "%s directory does not exist. Please create it."
msgstr "%s Thư mục không tồn tại. Vui lòng tạo thư mục đó."

msgid "Dotclear release key %s was not found"
msgstr "Khóa phát hành Dotclear %s không được tìm thấy"

msgid "Application can not be started twice."
msgstr "Ứng dụng không thể được khởi động hai lần."

msgid "Unable to load deprecated core"
msgstr "Không thể tải lõi đã bị loại bỏ"

msgid "<p>We apologize for this temporary unavailability.<br>Thank you for your understanding.</p>"
msgstr "<p>Chúng tôi xin lỗi vì sự cố tạm thời này.<br>Cảm ơn sự thông cảm của quý khách.</p>"

msgid "Unable to find class %s"
msgstr "Không thể tìm thấy lớp %s"

msgid "Unable to initialize class %s"
msgstr "Không thể khởi tạo lớp %s"

