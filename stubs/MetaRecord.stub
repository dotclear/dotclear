declare(strict_types=1);

namespace Dotclear\Database;

use Countable;
use Iterator;

/**
 * @brief   MetaRecord class
 *
 * @implements Iterator<int, array<mixed>>
 *
 * Methods added by record extensions (src/Schema/Extension, plugins…) are given
 * to static analysis by build-tools/phpstan/extension.neon.
 */
class MetaRecord implements Iterator, Countable
{
    public function current(): mixed
    {
        return $this;
    }

    public function key(): mixed
    {
        return $this;
    }

    public function next(): void
    {
      // Left empty intentionally, as this is a stub implementation.
    }

    public function rewind(): void
    {
      // Left empty intentionally, as this is a stub implementation.
    }

    public function valid(): bool
    {
        return true;
    }

    public function count(): int
    {
        return 0;
    }
}
